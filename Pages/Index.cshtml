@page
@model IndexModel
@{
    ViewData["Title"] = "Upload";
}

<div class="hero">
    <div class="hero-badge">
        <span class="hero-badge-dot"></span>
        PDF Contract Analysis
    </div>
    <h1>Compare Contract Versions<br/>Instantly</h1>
    <p>Upload two PDF contracts and get a detailed analysis of every meaningful change — financial terms, legal clauses, dates, and structural modifications.</p>
</div>

<div class="upload-container">
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="error-alert">
            @Model.ErrorMessage
        </div>
    }

    <div class="upload-card">
        <form method="post" enctype="multipart/form-data" id="uploadForm">
            <div class="upload-grid">
                <div class="drop-zone" id="dropOriginal">
                    <input type="file" name="original" id="originalFile" accept=".pdf" />
                    <div class="drop-content">
                        <div class="drop-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                            </svg>
                        </div>
                        <h3>Original Contract</h3>
                        <p class="drop-hint">Drag & drop PDF or click to browse</p>
                        <p class="file-name" id="originalName"></p>
                        <div class="file-check">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        </div>
                    </div>
                </div>

                <div class="vs-badge">VS</div>

                <div class="drop-zone" id="dropRevised">
                    <input type="file" name="revised" id="revisedFile" accept=".pdf" />
                    <div class="drop-content">
                        <div class="drop-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                                <line x1="12" y1="11" x2="12" y2="17"></line>
                                <line x1="9" y1="14" x2="15" y2="14"></line>
                            </svg>
                        </div>
                        <h3>Revised Contract</h3>
                        <p class="drop-hint">Drag & drop PDF or click to browse</p>
                        <p class="file-name" id="revisedName"></p>
                        <div class="file-check">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>

            <div class="submit-area">
                <button type="submit" class="btn-compare" id="compareBtn" disabled>
                    <span class="btn-text">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        Analyze Differences
                    </span>
                    <span class="btn-loading" style="display:none;">
                        <svg class="spinner" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
                        </svg>
                        Analyzing contracts...
                    </span>
                </button>
            </div>
        </form>
    </div>

    <div class="features">
        <div class="feature">
            <div class="feature-icon classify">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
            </div>
            <h4>Smart Classification</h4>
            <p>Changes rated Critical, Major, or Minor based on financial and legal impact analysis.</p>
        </div>
        <div class="feature">
            <div class="feature-icon semantic">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                    <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                </svg>
            </div>
            <h4>Semantic Understanding</h4>
            <p>Detects clauses, sections, definitions, and signature blocks — not just line-by-line text diff.</p>
        </div>
        <div class="feature">
            <div class="feature-icon reports">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
            </div>
            <h4>Detailed Reports</h4>
            <p>Side-by-side diff with highlighted changes, executive summary, and downloadable HTML reports.</p>
        </div>
    </div>
</div>
