@page
@model ResultsModel
@{
    ViewData["Title"] = "Results";
}

<div class="results-toolbar">
    <a href="/" class="btn-back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px;">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        New Comparison
    </a>
    @if (Model.Result != null)
    {
        <a href="/Results?handler=Download&id=@Model.Result.ComparisonId" class="btn-download">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Download Report
        </a>
    }
</div>

<div class="results-container">
    @if (Model.Result != null)
    {
        <div class="report-embed">
            @Html.Raw(Model.ReportHtml)
        </div>
    }
    else
    {
        <div class="no-results">
            <p>No comparison results found. Please upload two documents to compare.</p>
            <a href="/" class="btn-compare">Go to Upload</a>
        </div>
    }
</div>
